over "World"
{
    over "Geo"
    {
        over "nvidia_shader_ball"
        {
            over "nvidia_shader_ball_09"
            {
                over "shader_ball"
                {
                    over "geo_shaderball_mat_01" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </World/Looks/Plastic/Pristine_Plastic_Hex_Pattern_01> (
                            bindMaterialAs = "weakerThanDescendants"
                        )
                    }

                    over "Plane_mat_01" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </World/Looks/Plastic/Pristine_Plastic_Hex_Pattern_01> (
                            bindMaterialAs = "weakerThanDescendants"
                        )
                    }

                    over "Cube_mat_01" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </World/Looks/Plastic/Pristine_Plastic_Hex_Pattern_01> (
                            bindMaterialAs = "weakerThanDescendants"
                        )
                    }

                    over "Sphere_mat_01" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </World/Looks/Plastic/Pristine_Plastic_Hex_Pattern_01> (
                            bindMaterialAs = "weakerThanDescendants"
                        )
                    }
                }
            }
        }

        over "Sphere" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = None (
                bindMaterialAs = "weakerThanDescendants"
            )
            double3 xformOp:rotateXYZ = (0, 0, 0)
            double3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (16.58906525698012, 125.98051637433883, 127.99357787981953)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }

        over "CUBE"
        {
            over "Geo"
            {
                over "Cube"
                {
                    double3 xformOp:rotateXYZ = (0, 0, 0)
                    double3 xformOp:scale = (1, 1, 1)
                    double3 xformOp:translate = (-430.18792798451364, 50, 156.8457843185873)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
                }
            }
        }
    }

