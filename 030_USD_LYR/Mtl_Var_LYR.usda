#usda 1.0
(
    framesPerSecond = 24
    metersPerUnit = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def "MatLib_a" (
    prepend references = @../010_ASS_USD/MatLib_a.usda@
)
{
}

def "GoodStart_ROOT" (
    prepend references = @../GoodStart_ROOT.usda@</World/Geo/nvidia_shader_ball/nvidia_shader_ball_09/geo_shaderball_mat_01_All>
    variants = {
        string mtl_Var_a = "material_1"
    }
    prepend variantSets = "mtl_Var_a"
)
{
    variantSet "mtl_Var_a" = {
        "material_1" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            rel material:binding = </MatLib_a/mtlxmaterial_1>

        }
        "material_2" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        ) {
            rel material:binding = </MatLib_a/mtlxmaterial_2>

        }
    }
}

