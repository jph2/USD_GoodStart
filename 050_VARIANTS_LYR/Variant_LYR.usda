        dictionary renderSettings = {
        }
    }
    defaultPrim = "World"
    endTimeCode = 100
    metersPerUnit = 0.01
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Y"
)

over "Environment"
{
    over "ground"
    {
        float3[] extent = [(-1400, -1400, 0), (1400, 1400, 0)]
        point3f[] points = [(-700, -700, 0), (700, -700, 0), (-700, 700, 0), (700, 700, 0)]
        bool primvars:isMatteObject = 0
        texCoord2f[] primvars:st = [(0, 0), (14, 0), (14, 14), (0, 14)]
        token visibility = "inherited"
    }
}

over "World"
{
    over "Geo"
    {
        over "nvidia_shader_ball" (
            variants = {
                string Mtl_Variant = "material_1"
            }
            prepend variantSets = "Mtl_Variant"
        )
        {
            variantSet "Mtl_Variant" = {
                "material_1" (
                    customData = {
                        string[] variantPrimPaths = ["nvidia_shader_ball_09/geo_shaderball_mat_01_All"]
                    }
                ) {
                    over "nvidia_shader_ball_09"
                    {
                        over "geo_shaderball_mat_01_All" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding = </World/MatLib/mtlxopen_pbr_material_1> (
                                bindMaterialAs = "strongerThanDescendants"
                            )
                        }
                    }

                }
                "material_2" (
                    customData = {
                        string[] variantPrimPaths = ["nvidia_shader_ball_09/geo_shaderball_mat_01_All"]
                    }
                ) {
                    over "nvidia_shader_ball_09"
                    {
                        over "geo_shaderball_mat_01_All" (
                            prepend apiSchemas = ["MaterialBindingAPI"]
                        )
                        {
                            rel material:binding = </World/MatLib/mtlxopen_pbr_material_2> (
                                bindMaterialAs = "strongerThanDescendants"
                            )
                        }
                    }

                }
            }
        }
    }

    over "MatLib" (
        delete references = @../010_ASS_USD/MatLib_a.usda@
        prepend references = @../010_ASS_USD/mat/MatLib_a.usda@
    )
    {
    }
}

