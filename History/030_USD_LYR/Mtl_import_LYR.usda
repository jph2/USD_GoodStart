#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (0, 0, 50000)
                double radius = 500
            }
            dictionary Perspective = {
                double3 position = (-392.748613697913, 197.19504553339667, 290.58390826290315)
                double3 target = (87.19807908454948, 68.79241854912485, 129.21184478932946)
            }
            dictionary Right = {
                double3 position = (-50000, 0, 0)
                double radius = 500
            }
            dictionary Top = {
                double3 position = (0, 50000, 0)
                double radius = 500
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "E:/SynologyDrive/1000_WORK/0100_Customer/1040_Metaphore/010_Project/PipeTest/USD_GoodStart/Lay_USD/AssetImport.usda"
            dictionary locked = {
            }
            dictionary muteness = {
            }
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "World"
    endTimeCode = 100
    metersPerUnit = 0.01
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Y"
)

over "World"
{
    over "Geo"
    {
        over "nvidia_shader_ball"
        {
            over "nvidia_shader_ball_09"
            {
                over "Looks"
                {
                    over "Replace_with_NEW"
                    {
                        over "Shader"
                        {
                            color3f inputs:diffuse_reflection_color = (1, 0.17291069, 0)
                        }
                    }
                }
            }
        }

        over "CUBE"
        {
            over "Geo"
            {
                over "Cube" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </World/Looks/PreviewSurface_01> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                }
            }
        }

        over "Sphere" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = None (
                bindMaterialAs = "weakerThanDescendants"
            )
        }
    }

    over "Looks"
    {
        def Material "PreviewSurface_01"
        {
            token outputs:displacement.connect = </World/Looks/PreviewSurface_01/Shader.outputs:displacement>
            token outputs:surface.connect = </World/Looks/PreviewSurface_01/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4351585, 0.12164374, 0.1487489)
                float inputs:roughness = 0.32999998
                token outputs:displacement
                token outputs:surface
            }
        }

        over "OmniPBR_ClearCoat"
        {
            over "Shader"
            {
                color3f inputs:diffuse_color_constant = (0.02915065, 0.07320011, 0.086455345)
                float inputs:reflection_roughness_constant = 0.089999996
            }
        }
    }

    def Xform "MatLib" (
        references = @../010_ASS_USD/MatLib_a_MAT.usda@
    )
    {
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }
}

over "Environment"
{
    over "ground" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-1400, -1400, 0), (1400, 1400, 0)]
        rel material:binding = </World/Looks/OmniPBR_ClearCoat> (
            bindMaterialAs = "weakerThanDescendants"
        )
        point3f[] points = [(-700, -700, 0), (700, -700, 0), (-700, 700, 0), (700, 700, 0)]
        bool primvars:isMatteObject = 0
        texCoord2f[] primvars:st = [(0, 0), (14, 0), (14, 14), (0, 14)]
        token visibility = "inherited"
    }
}

over "variantblock_end1" (
    variants = {
        string mtl_Var_a = "material_1"
    }
)
{
}

over "GoodStart_ROOT" (
    variants = {
        string mtl_Var_a = "material_2"
    }
)
{
}

