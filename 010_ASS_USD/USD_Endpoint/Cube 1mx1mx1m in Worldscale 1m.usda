        custom double[] measure:compute:secondary = []
        custom vector3d[] measure:meta:local_points = [(-50, 50, 50), (50, 50, 50)]
        custom int[] measure:meta:prim_path_indices = [0, 0]
        custom rel measure:meta:prim_paths_relationship = </World/Cube>
        custom int measure:meta:tool_mode = 0
        custom int measure:meta:tool_sub_mode = -1
        custom token measure:prop:axis_display = "NONE" (
            allowedTokens = ["NONE", "WORLD", "LOCAL"]
        )
        custom color4f measure:prop:label_color = (0, 1, 1, 1)
        custom token measure:prop:label_size = "MEDIUM" (
            allowedTokens = ["SMALL", "MEDIUM", "LARGE", "EXTRA_LARGE"]
        )
        custom string measure:prop:name = "measurement_point_to_point"
        custom token measure:prop:precision = "HUNDRETH" (
            allowedTokens = ["INTEGER", "TENTH", "HUNDRETH", "THOUSANDTH", "TEN_THOUSANDTH", "HUNDRED_THOUSANDTH"]
        )
        custom token measure:prop:unit = "METERS" (
            allowedTokens = ["CENTIMETERS", "MILLIMETERS", "DECIMETERS", "METERS", "KILOMETERS", "INCHES", "FEET", "MILES"]
        )
        custom bool measure:prop:visible = 1
        custom int measure:uuid = 13049610
    }
}

